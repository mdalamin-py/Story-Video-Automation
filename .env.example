OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
# Token controls for the story plan. GPT-5/o-series default to low reasoning; "default" sends none.
OPENAI_REASONING_EFFORT=
OPENAI_MAX_OUTPUT_TOKENS=
# Identical briefs reuse the saved plan in runs/story-cache. Set 0 to always ask for a new plan.
STORY_CACHE=
# Story AI picker on the Create page: Auto uses the cheapest connected AI (Gemini, OpenAI, Claude).
GEMINI_API_KEY=
GEMINI_STORY_MODEL=
ANTHROPIC_API_KEY=
# Default claude-opus-5-5 at medium effort; e.g. claude-sonnet-5-5 or claude-haiku-5-5 cost less.
CLAUDE_STORY_MODEL=
CLAUDE_STORY_EFFORT=
# GPT Image quality: low, medium (default), high or auto.
IMAGE_QUALITY=
# Local cinematic planner. Empty keeps your Codex defaults; a lower effort uses less of your quota.
# Full path to codex.exe, only if the studio cannot find the Codex app by itself.
CODEX_PATH=
CODEX_MODEL=
CODEX_REASONING_EFFORT=
MUSE_PROVIDER=
MUSE_API_KEY=
FFMPEG_PATH=
# Render workers for drafts and exports; blank uses as many as fit in memory.
RENDER_WORKERS=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_TOKEN=
FACEBOOK_GRAPH_VERSION=
STORY_PROVIDER_CONFIG=
VIDEO_PROVIDER=
RUNWAY_API_KEY=
TTS_PROVIDER=
TTS_MODEL=
TTS_VOICE=
ELEVENLABS_API_KEY=
VIDEO_FALLBACK_PROVIDER=
TTS_FALLBACK_PROVIDER=
TTS_FALLBACK_MODEL=
TTS_FALLBACK_VOICE=
IMAGE_PROVIDER=
IMAGE_MODEL=
STUDIO_ADMIN_TOKEN=
STUDIO_S3_BUCKET=
STUDIO_S3_ENDPOINT=
RUNWAY_VIDEO_MODEL=
VERTEX_PROJECT=
VERTEX_REGION=
VERTEX_ACCESS_TOKEN=
OPENAI_ADMIN_KEY=
OPENAI_COST_PROJECT_ID=
MUSE_HEALTH_TASK_ID=
